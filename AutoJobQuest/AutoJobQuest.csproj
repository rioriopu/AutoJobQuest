<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <!--
    TargetFramework / LangVersion / Platforms / Nullable / AllowUnsafeBlocks /
    DalamudLibPath / DalamudPackager の参照は Dalamud.NET.Sdk の既定値を使う。
  -->
  <PropertyGroup>
    <Version>0.1.0.1</Version>
    <RootNamespace>AutoJobQuest</RootNamespace>
    <AssemblyName>AutoJobQuest</AssemblyName>
    <Description>製作系・採集系のジョブクエ（Lv1〜70）の素材集め・製作・マテリア装着・クエスト進行を自動で行う</Description>
    <Authors>Estell</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- manifest 本体。DalamudPackager が InternalName / AssemblyVersion / DalamudApiLevel を補完する -->
    <Content Include="AutoJobQuest.json" />
  </ItemGroup>

  <!--
    ライセンスと第三者の表示を出力フォルダへ写す。DalamudPackager は出力フォルダの中身を zip にするので、配布物にも入る
    （同梱する GPL・Apache のライブラリは、配布物にライセンスを添えることを求めている）。
  -->
  <ItemGroup>
    <None Include="..\LICENSE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\licenses\*.txt" LinkBase="licenses" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- ビルド時刻をアセンブリへ埋め込む（古い DLL が動いていないかの切り分け用） -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <!--
    ECommons は使っていない（画面操作・コールバックは FFXIVClientStructs で直接書いた）。
    初期化せずに同梱すると紛らわしいので参照しない。
  -->
  <ItemGroup>
    <!-- モンスターのドロップ表と出現位置（ゲームデータに無いため） -->
    <PackageReference Include="LuminaSupplemental.Excel" Version="4.3.3" />
  </ItemGroup>

  <!--
    ビルドしたら dev プラグインの置き場へコピーする。
    DalamudPackager が manifest を作った後に走らせる（AfterTargets="Build" だと manifest がまだ無い）。
    依存 DLL（LuminaSupplemental とその依存）も一緒に置く。

    Release のターゲットの後だけに付ける。AfterTargets に Debug 側も並べると、Release では条件で飛ばされる
    Debug 側の番で先に走り、manifest を作り直す前の古いものを写してしまう。

    配置先は、既定では C:\DevPlugins\AutoJobQuest\（C:\DevPlugins がある PC だけ）。
    環境変数 AJQ_DEPLOY_DIR を指定すると、そちらに置く。どちらも無ければ配置しない
    （ビルドは通る。bin\Release\ の中身を手で置けばよい）。

        setx AJQ_DEPLOY_DIR "D:\MyPlugins\AutoJobQuest\"
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DeployDir>$(AJQ_DEPLOY_DIR)</DeployDir>
    <DeployDir Condition="'$(DeployDir)' == '' And Exists('C:\DevPlugins')">C:\DevPlugins\$(AssemblyName)\</DeployDir>
  </PropertyGroup>

  <Target Name="DeployToPluginFolder"
          AfterTargets="DefaultDalamudPackagerRelease"
          Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)*.dll;$(OutputPath)*.json" />
    </ItemGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="ActuallyCopied" />
    </Copy>
    <Warning Condition="'@(ActuallyCopied)' == ''"
             Text="配置できませんでした。ゲームが DLL を掴んでいる可能性があります。もう一度ビルドしてください。" />
    <Message Condition="'@(ActuallyCopied)' != ''" Importance="high" Text="配置しました: $(DeployDir)" />
    <Warning Condition="!Exists('$(DeployDir)$(AssemblyName).json')"
             Text="manifest（$(AssemblyName).json）が配置されていません。このままでは Dalamud の一覧に出ません。" />
  </Target>

</Project>
